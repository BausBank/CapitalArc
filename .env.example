# ============================================================
# CapitalArc - Environment configuration TEMPLATE
# ------------------------------------------------------------
# This file is committed to git and contains placeholders only.
# DO NOT put real secrets here.
#
# To set up your local environment:
#   1. Copy this file:  cp .env.example .env
#   2. Replace every "your_..._here" placeholder with a real value.
#   3. Never commit `.env` - it is git-ignored on purpose.
# ============================================================
#
# ╔══════════════════════════════════════════════════════════════╗
# ║  QUICK-START SAFE-DEFAULTS PROFILES                          ║
# ╠══════════════════════════════════════════════════════════════╣
# ║                                                              ║
# ║  Choose a profile by setting the four knobs below.           ║
# ║  Everything else in this file can stay at defaults.          ║
# ║                                                              ║
# ║  ┌──────────────────┬──────────────┬──────────┬───────────┐  ║
# ║  │ Setting          │ Conservative │ Balanced │ Aggressive│  ║
# ║  ├──────────────────┼──────────────┼──────────┼───────────┤  ║
# ║  │ RISK_PER_TRADE   │   0.5  (0.5%)│ 1.0 (1%) │ 1.5 (1.5%)│  ║
# ║  │ L3_AGGRESSION    │ conservative │ balanced │ aggressive│  ║
# ║  │ MAX_POSITION_USD │   3 000      │ 10 000   │ 25 000    │  ║
# ║  │ MAX_DRAWDOWN_PCT │   5.0        │ 10.0     │ 12.0      │  ║
# ║  └──────────────────┴──────────────┴──────────┴───────────┘  ║
# ║                                                              ║
# ║  RECOMMENDED for first live runs: CONSERVATIVE.              ║
# ║  Once you've watched 50+ cycles and trust the telemetry,     ║
# ║  graduate to BALANCED. Use AGGRESSIVE only with a proven     ║
# ║  edge + a small account; it enables HOLD-rescue + any-       ║
# ║  direction L2 rescue + HOLD-must-be-earned, so the LLM is    ║
# ║  more interventionist.                                       ║
# ║                                                              ║
# ║  Smart Path (LLM) is HARD-CAPPED at one call per position    ║
# ║  per 25 minutes regardless of any value below, so cost stays ║
# ║  bounded even if you misconfigure the per-position cooldown. ║
# ╚══════════════════════════════════════════════════════════════╝


# ---------- General ----------
# Runtime mode: dev | staging | prod
APP_ENV=dev
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Two-speed cycle intervals for --loop mode.
#
# DECISION_INTERVAL_SECONDS controls the FULL cycle: L1 + L2 + L3 +
# AllocationRouter + PositionManager. This is where Dune MCP and
# OpenRouter API calls happen, so the interval is set conservatively
# (600s = 10 min) to bound their cost while still tracking the 15m/1h
# timeframes the L1 cascade uses. Set to 0 for back-to-back replay.
DECISION_INTERVAL_SECONDS=600
# DECISION_FAST_INTERVAL_SECONDS controls the FAST cycle: PositionManager
# Fast Path only - dynamic SL/TP, trailing stop, time exit, breakeven,
# vol spike, daily-DD kill switch. NO Dune / OpenRouter calls; the
# fast cycle never reads market data and never opens new positions.
# It only issues close_position / partial_close when the off-chain
# rules fire on a position whose native venue-side TP/SL hasn't
# triggered yet. 120s (2 min) gives a 5x oversampling vs the full
# cycle, so adverse moves are caught minutes before the next full
# re-arbitration. Set to 0 to disable the fast cycle entirely (the
# loop reverts to single-speed full-cycle ticks).
DECISION_FAST_INTERVAL_SECONDS=120
# Demo mode: Level 2 caches results for DEMO_CACHE_TTL_SECONDS
DEMO_MODE=true
DEMO_CACHE_TTL_SECONDS=1800


# ---------- Arc Chain ----------
# RPC endpoint for Arc (testnet or mainnet)
ARC_RPC_URL=https://rpc.testnet.arc.network
# Arc chain ID (numeric)
ARC_CHAIN_ID=your_arc_chain_id_here
# Arc block explorer base URL (used for tx links in logs)
ARC_EXPLORER_URL=your_arc_explorer_url_here


# ---------- Hyperliquid Testnet (PRIMARY TRADING VENUE) ----------
# CapitalArc trades real long/short perp positions on Hyperliquid
# Testnet. Arc + Circle stay on the treasury / yield leg
# (USYC, CCTP, Paymaster) - see USYC_* and CIRCLE_* sections below.
#
# Capital flow:
#   Risk-off : USDC on Arc -> USYC mint (yield, see USYC section)
#   Risk-on  : USYC redeem -> USDC on Arc -> CCTP -> Arbitrum -> HL
#              bridge -> Hyperliquid balance -> HL perp open
#
# Fund the testnet account via the Hyperliquid testnet faucet at
# https://app.hyperliquid-testnet.xyz (mock USDC, no real risk).
#
# === Execution-vs-data URL split (read this before touching the URLs) ===
# We deliberately separate the two endpoints below to decouple "where
# we trade" from "where we read the market":
#
#   * HYPERLIQUID_API_URL       -> EXECUTION venue. Every signed order
#                                  and every read of OUR account state
#                                  (margin, positions, fills) goes here.
#                                  Use mainnet ONLY if you've fully
#                                  audited the agent (real USDC at risk).
#
#   * HYPERLIQUID_DATA_API_URL  -> MARKET-DATA venue (always mainnet).
#                                  Reserved for callers that need market-
#                                  wide intelligence (asset universe,
#                                  real perp OI / funding / L-S via the
#                                  Hyperliquid Info API). Pinning this
#                                  to mainnet means flipping the
#                                  execution venue between testnet and
#                                  mainnet never silently degrades the
#                                  data plane to the thin testnet tape.
#
# NOTE (Day 5 status): Level 2 currently reads on-chain proxies via
# Dune MCP on DUNE_CHAIN - it does NOT yet call the Hyperliquid Info
# API at all, so today the DATA_API_URL is load-bearing only for the
# executor's own ``info_data`` accessor (reserved for the upcoming
# direct-Hyperliquid analytics adapter). Keeping it correctly set NOW
# means that adapter lands on mainnet by default the moment it's wired.
HYPERLIQUID_API_URL=https://api.hyperliquid-testnet.xyz
HYPERLIQUID_DATA_API_URL=https://api.hyperliquid.xyz
# Master switch for the HyperliquidIntelligenceAdapter overlay
# (Day 6+). When true (the default and recommended setting), Level 2
# overlays REAL Hyperliquid Info-API data (funding / OI / volume /
# cum_funding) on top of the Dune-derived proxies, eliminating the
# spot-DEX OI-collapse artefacts. Set to false to roll back to the
# pure-Dune path (e.g. for A/B comparison or while debugging).
HYPERLIQUID_INTELLIGENCE_ENABLED=true
# EVM private key the agent signs Hyperliquid orders with.
#
# TESTNET ONLY. Generate a fresh key (e.g. `cast wallet new` /
# `web3 eth-account create`), faucet it on the testnet bridge at
# https://app.hyperliquid-testnet.xyz and paste it below. The agent's
# real .env (git-ignored) ships with a pre-provisioned testnet key
# whose corresponding address is 0xdC0C20...95A - that key holds only
# mock USDC and has zero real-world value. Do NOT reuse a key created
# here on mainnet or any chain that holds real capital.
#
# NEVER commit a real (mainnet) key. The agent's git history is
# explicitly checked for accidental key leaks; if you see this file
# tracked with a real key, rotate it immediately.
HYPERLIQUID_PRIVATE_KEY=your_hyperliquid_testnet_private_key_here
# Master account address. Leave empty to default to the signer's
# own address (typical single-wallet setup). Set ONLY when running
# the signer as an API-wallet sub-key allowed to trade on behalf of
# a different master account (Hyperliquid's "approve agent" flow).
HYPERLIQUID_ACCOUNT_ADDRESS=
# Optional Hyperliquid vault address (multi-strat or PnL-shared
# vault). Leave empty for the single-signer case.
HYPERLIQUID_VAULT_ADDRESS=
# Hard caps applied BEFORE the SDK call regardless of router output.
HYPERLIQUID_MAX_LEVERAGE=5
HYPERLIQUID_MAX_POSITION_USD=10000
HYPERLIQUID_DEFAULT_SLIPPAGE_BPS=50
# Default take-profit / stop-loss thresholds applied by PositionManager
# (positive fractions; 0.02 = +2% TP, 0.015 = -1.5% SL).
HYPERLIQUID_DEFAULT_TAKE_PROFIT_PCT=0.02
HYPERLIQUID_DEFAULT_STOP_LOSS_PCT=0.015
# When true, open / close use market orders (immediate fill). When
# false, the executor posts marketable limit orders at mid +/-
# HYPERLIQUID_DEFAULT_SLIPPAGE_BPS.
HYPERLIQUID_USE_MARKET_ORDERS=true


# ---------- Arc Perp DEX (DEPRECATED) ----------
# Arc Perp DEX is no longer the trading venue - the public matcher
# spec was never published, see https://docs.arc.network. These
# settings remain ONLY so legacy treasury reads / dry-run telemetry
# code keeps compiling. ``open_position`` / ``close_position`` on
# ArcPerpExecutor are no-ops in --live mode.
#
# Strong candidate from Arc Testnet Blockscout (verified stack):
#   ClearingHouse        0x70a069462195E57A4f2E9aCb626Cf1d7E6aF9892
#   USDCCollateralVault  0x75E4FBFBA942A82F0f5CA9663571233823A71f11
#   MarketRegistry       0x9cED23e4a154769a5578D14BA63c01775003feB1
#   PositionLedger       0xd6D772918435a11d03E71158aFd44f3d48a1E148
ARC_PERP_ROUTER_ADDRESS=
ARC_PERP_VAULT_ADDRESS=
ARC_PERP_MARKET_REGISTRY_ADDRESS=
ARC_PERP_POSITION_LEDGER_ADDRESS=
ARC_PERP_MAX_LEVERAGE=3
# Default trading symbols (comma separated) - shared by L1/L2 + the
# Hyperliquid executor (which strips ``-PERP`` to map to HL coins).
ARC_PERP_SYMBOLS=BTC-PERP,ETH-PERP


# ---------- Circle: Developer-Controlled Wallets ----------
# Circle API key (Developer-Controlled Wallets). Use a TEST key for the sandbox.
CIRCLE_API_KEY=your_circle_api_key_here
# Entity secret used to encrypt wallet operations (generate from Circle console)
CIRCLE_ENTITY_SECRET=your_circle_entity_secret_here
# Wallet set ID where the agent's wallets live
CIRCLE_WALLET_SET_ID=your_circle_wallet_set_id_here
# Specific wallet ID used as the agent's primary execution wallet
CIRCLE_AGENT_WALLET_ID=your_circle_agent_wallet_id_here


# ---------- Circle: CCTP (Cross-Chain Transfer Protocol) ----------
# Source chain domain ID (for CCTP transfers into Arc)
CCTP_SOURCE_DOMAIN=your_cctp_source_domain_here
# Destination chain domain ID (Arc)
CCTP_DESTINATION_DOMAIN=your_cctp_destination_domain_here
# CCTP TokenMessenger contract address on the source chain
CCTP_TOKEN_MESSENGER_ADDRESS=your_cctp_token_messenger_address_here
# CCTP MessageTransmitter contract address
CCTP_MESSAGE_TRANSMITTER_ADDRESS=your_cctp_message_transmitter_address_here


# ---------- Circle: Paymaster (gasless tx) ----------
# Paymaster URL / endpoint used to sponsor gas
CIRCLE_PAYMASTER_URL=your_circle_paymaster_url_here
# Paymaster policy ID, if applicable
CIRCLE_PAYMASTER_POLICY_ID=your_circle_paymaster_policy_id_here


# ---------- USYC (Yield-bearing risk-off leg) ----------
# When the engine flips to risk-off (low conviction / neutral direction),
# the AllocationRouter closes any open perp position, withdraws margin,
# and rotates the free USDC into USYC so capital keeps earning ~T-bill
# yield while we wait for the next risk-on setup. On risk-on it can
# redeem USYC back into USDC just-in-time to fund the new perp.
#
# Leaving any of the three address fields below blank turns the
# rotation leg into a graceful no-op - the router still closes perps
# but skips the USYC mint / redeem with an explanatory note in the
# ExecutionPlan (no hard failure, demo keeps running).
#
# USYC token contract address on Arc.
USYC_TOKEN_ADDRESS=your_usyc_token_address_here
# USYC mint / redeem contract address (the "vault" front-door, not the
# token itself; some deployments collocate the two but most don't).
USYC_MINT_CONTRACT_ADDRESS=your_usyc_mint_contract_address_here
# Smallest single USDC -> USYC rotation we submit. Below this the
# router skips the rotation to avoid sub-economic dust transactions.
USYC_MIN_ROTATION_AMOUNT=100
# Hard cap on any single USYC mint or redeem (USD). Safety net so a
# runaway decision-engine loop stays financially bounded on testnet.
USYC_MAX_ROTATION_AMOUNT=100000
# Free USDC reserve to keep in the agent wallet at all times. The
# risk-off path mints USYC only with `free_usdc - reserve`, so
# non-sponsored gas fallbacks and the next perp entry's initial-
# margin call never hit a "wallet empty" state.
USYC_USDC_RESERVE_USD=50
# When false, the AllocationRouter skips the USYC leg entirely even
# if contracts are configured. Use this to demo a perp-only build
# of the agent without re-blanking USYC addresses.
#
# === TEMPORARY FOR TESTING (Hyperliquid perp-only mode) ===
# Set USYC_ENABLED=false to allow clean live testing of the trading
# leg alone. With the flag off:
#   * The pre-flight check in main.py does NOT require the three
#     USYC_*_ADDRESS / USDC_TOKEN_ADDRESS values, so --live can start
#     with only Hyperliquid + Circle credentials wired.
#   * The router still closes perps on risk-off but skips the
#     USDC -> USYC mint, leaving the freed margin sitting in USDC.
#     A `rotation_skipped` note is stamped on the ExecutionPlan so
#     the decision log keeps an honest audit trail of the missing leg.
# Re-enable USYC by flipping this to `true` AND populating the three
# address values above; the pre-flight will then require all of them.
USYC_ENABLED=true
# Optional ABI overrides if the deployed USYC contract on Arc uses
# non-standard mint / redeem function names (e.g. deposit/withdraw,
# subscribe/unsubscribe). Defaults match Hashnote / Ondo / Backed.
USYC_MINT_SIGNATURE=mint(uint256)
USYC_REDEEM_SIGNATURE=redeem(uint256)
# === Risk-off WITHDRAW safety gate ===
# When true, a risk-off directive (Daily-DD kill-switch, full risk-off
# verdict from the engine, etc.) will close every open perp AND
# withdraw all remaining USDC margin from Hyperliquid back to the
# signer's Arbitrum wallet (1-block bridge). When false (default for
# safety), risk-off only CLOSES positions and leaves the freed USDC
# sitting in the perp sub-account, ready for the next risk-on
# entry.
#
# Why default off: a withdraw is the only step in the risk-off
# pipeline that physically moves capital between subaccounts. With
# the gate off, even a buggy equity / PnL read that falsely fires
# the kill-switch can ONLY close positions - it can never
# auto-drain the venue. The USYC mint leg is also skipped while
# this gate is off (there is nothing freed on Arc to mint with).
#
# Flip to true once you trust the equity / PnL read end-to-end and
# want capital to rotate all the way to USYC on a real risk-off.
RISK_OFF_WITHDRAW=false


# ---------- USDC ----------
# Native / canonical USDC address on Arc
USDC_TOKEN_ADDRESS=your_usdc_token_address_here


# ---------- Dune MCP (single source of truth for L1 + L2) ----------
# Dune MCP is the *only* market-data source for the agent. Both Level 1
# (OHLCV / TA) and Level 2 (on-chain intelligence) read through saved
# Dune queries. No CEX feed, no direct RPC market-data scraping.
#
# Arc Testnet isn't indexed by Dune yet, so the saved queries target
# a live, high-liquidity EVM chain (`ethereum` by default; `base` /
# `arbitrum` are trivially selectable). The agent's symbols
# (BTC-PERP / ETH-PERP) map to the canonical on-chain wraps of
# BTC / ETH on the chosen chain.
#
# Dune Analytics API key (used by the MCP client for on-chain queries)
DUNE_API_KEY=your_dune_api_key_here
# Dune MCP server URL (LLM-facing tool surface)
DUNE_MCP_URL=https://mcp.dune.com/sse
# Dune REST endpoint that the MCP server wraps (we hit this directly
# with the same DUNE_API_KEY for deterministic, cacheable reads).
DUNE_API_BASE_URL=https://api.dune.com/api/v1
# Max age (seconds) for a cached Dune result before re-querying
DUNE_CACHE_TTL_SECONDS=1800
# Active chain for L1 + L2 (matches `dex.trades.blockchain` and the
# `erc20_<chain>.evt_Transfer` schema). Supported out of the box:
# ethereum, base, arbitrum.
DUNE_CHAIN=ethereum
# Default lookback window (hours) for time-series metrics.
DUNE_LOOKBACK_HOURS=24

# Dune REST throttling: L2 fans out 8 metric calls + L1 fans out 1
# OHLCV call in parallel. On free-tier plans the burst hits HTTP 429
# and metrics render as `error`. The client caps concurrent in-flight
# requests with a semaphore and retries 429s with exponential
# backoff. Defaults are tuned for free tier (~10 reqs/min). Bump
# CONCURRENT_REQUESTS to 6-8 if you have a paid Dune plan.
DUNE_MAX_CONCURRENT_REQUESTS=2
DUNE_RATE_LIMIT_MAX_RETRIES=6
DUNE_RATE_LIMIT_BACKOFF_SECONDS=2.5

# Optional per-token overrides. Blank = use the built-in canonical
# map (WBTC/cbBTC, WETH, native USDC on each chain).
DUNE_TOKEN_BTC_ADDRESS=
DUNE_TOKEN_ETH_ADDRESS=
DUNE_TOKEN_USDC_ADDRESS=

# Address watched by vault_flows.sql for USDC deposits / withdrawals.
# Defaults to ARC_PERP_VAULT_ADDRESS when unset; point at any vault
# on DUNE_CHAIN (e.g. Synthetix V3 collateral on Base) for real data.
DUNE_PERP_VAULT_ADDRESS=

# Whale threshold (USD) for whale_activity.sql.
DUNE_WHALE_MIN_USD=250000

# Per-metric saved Dune query ids. Save the SQL files in dune/queries/
# to your Dune workspace, then paste the resulting numeric ids here.
# `DUNE_QUERY_OHLCV_ID` is required for Level 1 to evaluate; without
# it Level 1 honestly blocks on `ohlcv_unavailable`.
DUNE_QUERY_OHLCV_ID=
DUNE_QUERY_FUNDING_RATES_ID=
DUNE_QUERY_OPEN_INTEREST_ID=
DUNE_QUERY_VOLUME_ID=
DUNE_QUERY_VAULT_FLOWS_ID=
DUNE_QUERY_WHALE_ACTIVITY_ID=
DUNE_QUERY_LONG_SHORT_RATIO_ID=
DUNE_QUERY_CUM_FUNDING_ID=
DUNE_QUERY_MARKET_SENTIMENT_ID=


# ---------- Level 3 Intelligence: Claude Sonnet 4.6 via OpenRouter ----------
# OpenRouter API key: setting this is the ONLY toggle needed to switch
# L3 from synthetic placeholder to real Claude arbitration. Leave it
# blank and the engine emits a synthetic L3 whose weight is
# redistributed back to L1+L2 (REDISTRIBUTE_SYNTHETIC_L3_WEIGHT below).
#
# We migrated from Google's Gemini API (geo-locked away from several
# user regions, returns `400 User location is not supported` even on
# paid tier) to OpenRouter, which routes through their own
# infrastructure and stays globally accessible. The default upstream
# model is Anthropic's Claude Sonnet 4.6; switch to any model slug on
# https://openrouter.ai/models with a one-line change here.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Upstream model slug. Examples:
#   anthropic/claude-sonnet-4.6       (default, balanced reasoning)
#   anthropic/claude-opus-4.5         (deeper reasoning, ~3x cost)
#   openai/gpt-4o                     (fast, JSON-mode native)
#   mistralai/mistral-large-2411      (cheaper alternative)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Sampling temperature (0.0 = deterministic, recommended for trading)
OPENROUTER_TEMPERATURE=0.2
# Max output tokens per arbitration call. 2048 gives the critical-mode
# 5-section rationale room (Market Context / Key Signals Analysis /
# Contradictions & Risks / My Independent View / Final Recommendation
# typically lands at 600-1100 tokens; 1024 risks truncation on rich
# signal tables). Standard mode is unaffected - it rarely exceeds ~300.
OPENROUTER_MAX_TOKENS=2048
# Request timeout in seconds. Claude often takes 5-15s end-to-end.
OPENROUTER_TIMEOUT_SECONDS=60
# Bounded retry on transient failures (429 rate-limit, 5xx upstream,
# malformed JSON). Hard failures (auth, model-not-found, policy denial)
# bypass the retry loop and surface immediately with an actionable
# diagnosis. After exhausting all attempts the arbiter falls back to
# a neutral HOLD - we never trade on a hallucinated verdict.
OPENROUTER_MAX_RETRIES=2
OPENROUTER_BACKOFF_SECONDS=2.0
# Optional analytics headers - visible on https://openrouter.ai/activity
# (useful when one key is shared across multiple projects).
OPENROUTER_REFERER=https://github.com/capitalarc/capitalarc
OPENROUTER_APP_TITLE=CapitalArc

# ---------- Level 3 mode ----------
# CapitalArc ships two distinct Level 3 personas:
#   - "critical" (default, recommended): Claude acts as an independent
#     senior risk manager. It is *allowed to disagree* with L1+L2 when
#     signals are weak or contradictory, and the rationale follows a
#     strict 5-section template so the demo shows *how* the decision
#     was reached. Best for product / hackathon demos.
#       Sections: Market Context | Key Signals Analysis |
#                 Contradictions & Risks | My Independent View |
#                 Final Recommendation
#   - "standard": legacy trader-voice prompt. Short 1-2 sentence
#     rationale with technical tags. Useful for high-frequency loops
#     where the structured rationale is overkill.
# Both modes share the same OpenRouter client + JSON schema -
# switching is a single line, no other env changes needed. Each mode
# resolves a distinct prompt file under `prompts/` (see
# prompts/level3_arbiter_critical.md / level3_arbiter_standard.md).
L3_MODE=critical


# ---------- Risk & Allocation ----------
# Final-score threshold above which the router goes risk-on (0.0 - 1.0)
RISK_ON_THRESHOLD=0.6
# Final-score threshold below which the router goes risk-off into USYC (0.0 - 1.0)
RISK_OFF_THRESHOLD=0.4
# Maximum portfolio drawdown before forced de-risk (percent)
MAX_DRAWDOWN_PCT=10

# Decision-engine level weights (must sum to 1.0)
WEIGHT_LEVEL1=0.25
WEIGHT_LEVEL2=0.35
WEIGHT_LEVEL3=0.40


# ---------- Conviction / direction controls ----------
# Minimum aggregated *direction strength* in [0, 1] for the engine to
# treat the side as decided. Direction is a conviction-weighted vote
# across L1 (primary symbol trend), L2 (on-chain bias) and L3 (when
# wired). Lower => more aggressive opens in either direction; higher
# => only the cleanest setups trade. The L1 short-circuit guard
# always wins, so a blocked L1 never opens.
SHORT_BIAS_MIN_STRENGTH=0.35
# Minimum direction strength required to override a mid-band hold and
# open a *reduced-size* position when the aggregated conviction is
# ambiguous but the directional signal is unanimous. Reduced
# intensity formula: `0.5 * conviction * direction_strength`.
STRONG_BIAS_OPEN_STRENGTH=0.6
# When true (default), a synthetic L3 score (no real Gemini wiring
# yet) gets its weight redistributed proportionally to L1 + L2 during
# aggregation, so the placeholder doesn't silently dilute the real
# signal back into itself. Flip to false to restore the legacy
# behaviour where synthetic L3 votes with its configured weight.
REDISTRIBUTE_SYNTHETIC_L3_WEIGHT=true

# ---------- Short-selling controls ----------
# When true, shorts use the same sizing pipeline as longs
# (recommended). Set to false + tune SHORT_SIZE_MULTIPLIER if you
# want half-size shorts during ramp-up.
SYMMETRIC_SHORT_SIZING=true
SHORT_SIZE_MULTIPLIER=1.0

# ---------- Position sizing (equity-% risk + vol-targeted + DD haircut) ----------
# Sizing pipeline:
#   1) Vol-target: size = (equity * effective_risk) /
#                          (STOP_ATR_MULT * ATR_pct/100)
#      effective_risk = RISK_PER_TRADE_PCT/100 * RISK_PER_TRADE_MULT_<SYM>
#      So 1% risk * 1.0x BTC / 1.5*ATR / ATR%=2% on $10k equity ->
#      $3 333 notional.
#   2) Multiply by intensity (engine conviction signal in [0, 1]).
#   3) Drawdown haircut: multiply by
#      max(0, 1 - (dd_pct/max_dd_pct) ** DD_HAIRCUT_EXPONENT).
#   4) Cap at MAX_POSITION_USD.
# Fallback when equity is 0 (first dry-run cycle, no margin yet):
# BASE_POSITION_USD * (1 + intensity).
BASE_POSITION_USD=1000
MAX_POSITION_USD=10000

# PRIMARY OPERATOR KNOB: percentage of CURRENT equity to risk on a
# single trade under a STOP_ATR_MULT * ATR adverse move.
# Operator-friendly format (1.0 = 1%, NOT a fraction).
# Sensible range: 0.5 .. 2.0 (textbook).
#   * 0.5  = very conservative; ideal during live capital ramp-up
#   * 1.0  = balanced (DEFAULT)
#   * 2.0  = aggressive; only with proven edge + small account
# Wins over the LEGACY TARGET_RISK_PCT below.
RISK_PER_TRADE_PCT=1.0
# LEGACY fraction-form knob; only consulted when RISK_PER_TRADE_PCT
# is unset. 0.02 = 2% (kept for backward compatibility).
TARGET_RISK_PCT=0.02

# Per-asset risk multipliers (dimensionless). 1.0 = full risk on the
# primary symbol; 0.5 = half-size on this asset. Lets the operator
# express asset-specific conviction without rewriting the engine.
# Sane bands: 0.25 .. 1.5.
RISK_PER_TRADE_MULT_BTC=1.0
RISK_PER_TRADE_MULT_ETH=1.0
RISK_PER_TRADE_MULT_DEFAULT=1.0

STOP_ATR_MULT=1.5
# ATR% floor used in the sizing denominator (avoids divide-by-zero
# and absurdly large sizes when ATR collapses). Keep close to
# L1_ATR_PCT_MIN below.
MIN_ATR_PCT_FOR_SIZING=0.25
# Exponent of the gradient drawdown haircut. 1.0 = linear (5% dd -> 50%
# size); 2.0 = soft early, hard near the cap (5% dd -> 75% size,
# 9% dd -> 19% size). Replaces the legacy "all-or-nothing at
# MAX_DRAWDOWN_PCT" behaviour.
DD_HAIRCUT_EXPONENT=2.0
# When true, the router stamps a full sizing breakdown
# (vol_target, intensity, haircut, atr_pct, risk_multiplier,
# effective_risk_pct, etc.) onto each ExecutionPlan so the panel
# can render the "why" behind each size.
EXPLAIN_SIZING=true


# ---------- Position management (Two-Tier PositionManager) ----------
# CapitalArc's PositionManager runs in TWO INDEPENDENT TIERS on every
# cycle:
#
#   * Fast Path (~ms, no LLM)
#     Always-on, deterministic, ATR-aware. Trigger ladder (priority
#     order, first match wins):
#
#       1. daily_dd_guard      portfolio-wide daily-loss kill switch
#       2. stop_loss           dynamic ATR-stop or fallback fixed %
#       3. vol_spike_close     live ATR >= VOL_SPIKE_MULT x entry ATR
#       4. time_exit           held longer than MAX_POSITION_HOLD_HOURS
#       5. take_profit         dynamic ATR-target or fallback fixed %
#       6. partial_take_profit scale out PARTIAL_TP_FRACTION at the
#                              first ATR target (one-shot, per position)
#       7. trailing_stop       ATR-trail from peak PnL
#       8. side_flip           engine flipped to opposite side
#       9. re_evaluation       conviction collapsed in modest profit
#
#     Plus state-only verbs (don't close on their own):
#       * breakeven_arm        flips BE flag; subsequent SL is lifted
#                              to entry + BREAKEVEN_BUFFER_PCT
#       * vol_spike_warn       advisory; next SL pass reads tighter ATR
#
#   * Smart Path (~1s, Claude Sonnet 4.6 via OpenRouter)
#     Per-position LLM review fired ONLY on material triggers
#     (price moved >= L3_REVIEW_TRIGGER_PRICE_ATR_MULT x ATR, funding /
#     OI / whale spike, or scheduled max-interval). Cheap when nothing
#     interesting happens. Verdict can OVERRIDE Fast Path when
#     L3_CAN_OVERRIDE_FAST_PATH=true.
#
# All percent fields are PERCENTAGES (3.0 = 3%), never fractions.
# Set any threshold to 0 to mute that trigger; or flip the matching
# ENABLE_* boolean below to keep the threshold (and the panel
# telemetry) but suppress the action.

# ---- Take-profit / stop-loss thresholds (off-chain + native venue) ----
# These percentages drive TWO things at once:
#
#   1. The off-chain Fast-Path SL/TP fall-back when L1 ATR% is missing
#      (PnL crosses +/-X% of notional -> close_position via the manager).
#   2. The native Hyperliquid TP/SL trigger orders submitted ONCE at
#      open time. Those are reduce-only and stay live for the entire
#      position lifetime - the Fast Path / Full cycle never touch
#      them. They're the always-on safety net even if the agent
#      process dies between cycles.
#
# When USE_DYNAMIC_ATR_TPSL=true (recommended) AND L1 ATR% is
# available, the venue-side trigger PRICES are computed from
# (TP_ATR_MULT * ATR) and (SL_ATR_MULT * ATR) instead of these fixed
# %s - same multipliers the Fast Path uses off-chain so the two
# sides never disagree on what "the stop" means.
#
# Defaults: +3.5% / -2.0% gives a textbook 1.75:1 reward-to-risk
# envelope (tighten in choppy markets, widen in trends).
TAKE_PROFIT_PCT=3.5
STOP_LOSS_PCT=2.0
# Trailing-stop "give-back" tolerance (notional %). Tracks peak PnL
# once the position has earned at least TRAILING_STOP_PCT of profit;
# closes when PnL drops more than TRAILING_STOP_PCT below that peak.
TRAILING_STOP_PCT=1.0
# Aggregated conviction (0..1) below which a *profitable* position is
# closed to lock in gains. Losers are handled by STOP_LOSS_PCT first.
MIN_CONVICTION_TO_HOLD=0.45
# Profit floor for the re-evaluation trigger. Prevents flattening a
# slightly-underwater position just because conviction wobbled.
RE_EVAL_MIN_PROFIT_PCT=0.5
# When true (default), an opposite-side directive flips the existing
# position on the same cycle (close + reopen).
AUTO_FLIP_ON_SIDE_CHANGE=true
# Master switches per trigger. Useful for muting an individual
# trigger during debugging without zeroing out its threshold.
ENABLE_TRAILING_STOP=true
ENABLE_RE_EVALUATION=true

# ---- Dynamic ATR-based TP/SL (PREFERRED PATH) ----
# When true, TP/SL/trailing PRICES are computed as multiples of the
# live ATR (recalculated every cycle, i.e. every 10 min in --loop
# mode). When the live ATR is unavailable for a symbol, the manager
# falls back to the fixed-pct values above for that cycle - no silent
# failure.
USE_DYNAMIC_ATR_TPSL=true
# SL distance from entry, in multiples of ATR. 1.2 = stop sits at
# entry +/- 1.2 ATRs (sane for medium-vol majors; tighten on calm
# markets, widen on storms).
SL_ATR_MULT=1.2
# TP distance from entry, in multiples of ATR. 3.0 -> ~2.5:1
# reward-to-risk vs the default SL_ATR_MULT=1.2.
TP_ATR_MULT=3.0
# Trailing-stop distance from peak, in multiples of ATR. The trail
# only arms after peak PnL has exceeded the trail distance once.
TRAIL_ATR_MULT=1.5

# ---- Partial Take-Profit (banking part of the move early) ----
# When true, the manager closes PARTIAL_TP_FRACTION of the position
# at PARTIAL_TP_ATR_MULT x ATR profit, once per position lifetime.
# Combines well with breakeven + trailing on the residual exposure.
ENABLE_PARTIAL_TAKE_PROFIT=true
# Distance from entry that triggers the partial close, in ATRs.
# 1.5 ATR = halfway to the full TP at TP_ATR_MULT=3.0.
PARTIAL_TP_ATR_MULT=1.5
# Fraction of the position to close on a partial TP fire. 0.50 = half.
PARTIAL_TP_FRACTION=0.50

# ---- Breakeven (move stop to entry once safely in profit) ----
# When true, once unrealised profit reaches BREAKEVEN_TRIGGER_ATR_MULT
# x ATR the manager lifts the effective SL to entry + buffer (for
# longs) or entry - buffer (for shorts). The lift is one-way: SL only
# tightens, never widens.
ENABLE_BREAKEVEN=true
# ATR multiple of profit that arms the BE flag. 1.0 = once profit
# reaches one full ATR.
BREAKEVEN_TRIGGER_ATR_MULT=1.0
# Buffer above entry the lifted SL is placed at. 0.05 = entry + 0.05%
# (a few ticks past zero so a single tick re-test doesn't stop us out).
BREAKEVEN_BUFFER_PCT=0.05

# ---- Volatility Filter (react to ATR spikes mid-position) ----
# Compares live ATR% to the ATR% snapshot taken when the position
# opened. When the ratio >= VOL_SPIKE_MULT, VOL_SPIKE_ACTION decides
# whether to close immediately or just tighten the next SL pass.
ENABLE_VOL_FILTER=true
# 1.8 = a 1.8x jump in ATR vs entry fires the spike.
VOL_SPIKE_MULT=1.8
# Either "close" (defensive flat) or "tighten_stop" (advisory; next
# cycle's SL pass uses the tighter live ATR snapshot).
VOL_SPIKE_ACTION=tighten_stop

# ---- Time-based exit (don't let stale ideas pile up) ----
# Master switch + maximum hold time in hours. When ENABLE_TIME_EXIT is
# false (or MAX_POSITION_HOLD_HOURS=0), the trigger is muted.
ENABLE_TIME_EXIT=true
MAX_POSITION_HOLD_HOURS=24.0

# ---- Daily / Global Drawdown Guard (portfolio kill switch) ----
# Tracks PnL since UTC midnight (resets every 24h). When the session
# loss crosses DAILY_LOSS_LIMIT_PCT of the equity at midnight, the
# manager flips a hard kill switch: every position is closed, USYC
# rotation runs, and the router refuses ALL new opens until the
# process restarts. This is the last-line defence above the per-trade
# STOP_LOSS_PCT and the per-cycle MAX_DRAWDOWN_PCT.
ENABLE_DAILY_DD_GUARD=true
# Session loss limit as a percentage of equity. 5.0 = 5% in 24h.
DAILY_LOSS_LIMIT_PCT=5.0

# ---- Per-asset ATR caps (vol-regime gate on NEW opens) ----
# Live 1h ATR% ceilings per asset. When the primary symbol's ATR%
# exceeds its cap, the router refuses a fresh risk-on (a position
# already open is unaffected; only the next entry is blocked). The
# L3 critical-mode prompt enforces the same gate at the LLM level.
PER_ASSET_ATR_CAP_BTC_1H=3.0
PER_ASSET_ATR_CAP_ETH_1H=4.0
PER_ASSET_ATR_CAP_DEFAULT_1H=3.0

# ---- Smart Path (L3 per-position review triggers) ----
# Master switch for the LLM-driven per-position arbiter. When false,
# only the Fast Path runs. When true, the manager calls Claude (same
# OpenRouter client as the main L3) ONLY when a gate below fires -
# never on quiet cycles.
ENABLE_SMART_PATH=true
# Price-move gate: invoke L3 when price has moved more than this
# multiple of ATR since the last L3 check for THIS position.
L3_REVIEW_TRIGGER_PRICE_ATR_MULT=1.5
# Funding-spike gate: invoke L3 when |funding rate| >= this fraction.
# 0.0005 = 0.05% per 8h funding window.
L3_REVIEW_TRIGGER_FUNDING_RATE=0.0005
# Whale-activity gate: invoke L3 when n_whales (per L2 intelligence)
# >= this integer threshold. 5 = below 5 whales is dismissed as noise.
L3_REVIEW_TRIGGER_WHALE_COUNT=5
# OI-delta gate (1h, %). 4.0 = a 4% OI move in 1h forces a review.
L3_REVIEW_TRIGGER_OI_DELTA_PCT=4.0
# Throttle floor between L3 calls per position. 30 = at most one
# call every 30 minutes for the same position even if gates spam.
L3_REVIEW_MIN_INTERVAL_MINUTES=30.0
# Forced periodic review. 120 = if nothing else triggers a review in
# 2 hours, call L3 anyway just to refresh the per-position verdict.
L3_REVIEW_MAX_INTERVAL_MINUTES=120.0
# When true, a strong L3 verdict (>= confidence threshold inside the
# manager) overrides the Fast Path decision; when false the verdict
# is recorded as advisory only. The exact confidence floor is set
# by L3_AGGRESSION below.
L3_CAN_OVERRIDE_FAST_PATH=true

# First-review delay (minutes). A brand-new position is NOT
# eligible for a Smart-Path review in its first N minutes - the
# Fast Path observes the entry first. Stops "L3 reviews every new
# open immediately" thrash. 10 = roughly one --loop cycle at the
# default DECISION_INTERVAL_SECONDS=600. Set to 0 only for tests.
L3_FIRST_REVIEW_DELAY_MINUTES=10.0

# ---- HARD COOLDOWN FLOOR (safety rail, NOT configurable) ----
# Regardless of L3_REVIEW_MIN_INTERVAL_MINUTES above, the
# PositionManager enforces a HARD floor of 25 MINUTES between
# per-position Smart-Path reviews. This is a cost-safety guarantee:
# even a buggy .env with `L3_REVIEW_MIN_INTERVAL_MINUTES=1` cannot
# burn an LLM call per cycle. The aggression-mode shift (see below)
# is ADDED on top, then clamped against this floor.
#
# Effective per-mode floor (default L3_REVIEW_MIN_INTERVAL_MINUTES=30):
#   conservative -> max(25, 30 + 15) = 45 min between reviews
#   balanced     -> max(25, 30 +  0) = 30 min between reviews
#   aggressive   -> max(25, 30 - 10) = 25 min between reviews

# ---- HOLD-rescue rule (Smart Path only) ----
# When the Fast Path wants HOLD on a position AND L2 conviction on
# the same symbol is >= HOLD_RESCUE_L2_MIN, the Smart Path is forced
# to review with a dedicated "hold_rescue" trigger and the LLM is
# told explicitly: "Fast Path wanted HOLD, but L2 strongly disagrees
# - close, scale out or stay the course?".
#
# Under L3_AGGRESSION=aggressive (see below), a HOLD reply to this
# rescue trigger is auto-rewritten to a small defensive partial
# close (~25%-29% of position size) so the LLM cannot duck the
# rescue. Under balanced / conservative, HOLD remains HOLD.
#
# When unset, defaults to True iff L3_AGGRESSION=aggressive (mirrors
# the main-engine HOLD-rescue semantics).
# ENABLE_HOLD_RESCUE=true
# Minimum L2 conviction required to trigger the rescue. Falls back
# to L3_HOLD_RESCUE_L2_MIN (the main-engine equivalent) when unset.
# Sensible bands: 0.55 .. 0.80.
# HOLD_RESCUE_L2_MIN=0.65
# Direction filter for the rescue:
#   "opposite" - rescue only when L2 contradicts the position
#                (default for balanced / conservative)
#   "any"      - rescue ALSO fires when L2 agrees with the position,
#                so the LLM can scale into a strong trend or raise
#                targets (auto-default for aggressive)
# HOLD_RESCUE_DIRECTION_MODE=opposite
# Anti-thrash: minimum time between rescue invocations for the same
# position even if L2 conviction stays high across many cycles.
HOLD_RESCUE_COOLDOWN_MINUTES=20.0

# ---- HOLD-must-be-earned (periodic re-audit) ----
# When True (auto-on under aggressive), a position that has been
# HOLDing for >= HOLD_MUST_BE_EARNED_MINUTES forces a fresh
# Smart-Path review even if no other gate has fired. Intent: HOLD
# shouldn't be a "we forgot about you" default - we should be
# regularly auditing whether each open slot is still earned.
# Suppressed when the previous Smart-Path verdict was already an
# explicit HOLD (avoids hitting the same answer twice in a row).
#
# COMPLEMENTS the "HOLD must be earned" classification in the Fast
# Path: every Fast-Path HOLD now carries a positive justification
# trigger (hold_trend_intact / hold_ranging /
# hold_low_conviction_profitable / hold_no_data) or is flagged as
# hold_unearned. Unearned HOLDs are surfaced loudly in the panel
# and are the first thing this periodic review picks up when
# enabled.
# ENABLE_HOLD_MUST_BE_EARNED=true
HOLD_MUST_BE_EARNED_MINUTES=45.0


# ┌────────────────────────────────────────────────────────────────────┐
# │ GLOBAL LLM BUDGET (cost-safety rail; Day-6+ "max-rare LLM")        │
# │                                                                    │
# │ Hard ceilings on TOTAL Smart-Path call volume across ALL positions │
# │ and across cycles. These sit ON TOP of the per-position cooldown   │
# │ ladder (hard floor + first-review delay + aggression shift +       │
# │ rescue cooldown). They are the ONLY guarantee against an N-       │
# │ position trigger storm producing N parallel OpenRouter calls.      │
# │                                                                    │
# │ When more candidates fire than fit in LLM_MAX_PER_CYCLE, the       │
# │ manager keeps the HIGHEST-priority ones (HOLD-rescue >             │
# │ close-audit > HOLD-must-be-earned > periodic > price/funding/     │
# │ whale/OI > first-review) and skips the rest (counted in stats).   │
# │ When LLM_MAX_PER_HOUR is exhausted, ALL Smart-Path calls are       │
# │ skipped regardless of trigger severity.                            │
# │                                                                    │
# │ Defaults assume DECISION_INTERVAL_SECONDS=600 (6 cycles/hr):       │
# │   2 calls/cycle * 6 cycles/hr = 12 candidates worst case           │
# │   capped at 8/hr -> effective ~5 USD/hour at Sonnet 4.6 rates.    │
# │ Raise only after observing actual call rates via panel.            │
# └────────────────────────────────────────────────────────────────────┘
LLM_MAX_PER_CYCLE=2
LLM_MAX_PER_HOUR=8


# ---- Conservative-mode hardening (Day-6+) ----
# Two flags that make CONSERVATIVE meaningfully more cautious than
# just "raise the override threshold". Both auto-resolve to True
# when L3_AGGRESSION=conservative; set explicitly to override.
#
# L3_CONSERVATIVE_VETO_ONLY=true
#   Under conservative, the LLM is allowed to VETO Fast-Path closes
#   (smart=hold downgrades close -> hold) but NOT to UPGRADE a
#   Fast-Path HOLD into a close (smart=close_full/partial).
#   HOLD-rescue is exempt because rescue is the operator explicitly
#   asking the LLM to act on contradiction. Net effect:
#   conservative mode treats the LLM as a brake, never as an
#   accelerator.
#
# L3_REQUIRE_MULTI_TRIGGER=true
#   Under conservative, Smart Path requires >= 2 corroborating
#   gates on the same position before invocation. A single
#   price-move or single funding spike isn't enough - we want at
#   least two independent signals before paying for an OpenRouter
#   round-trip. Rescue is exempt (its own cooldown). First-review
#   doesn't count as corroboration.
# L3_CONSERVATIVE_VETO_ONLY=true
# L3_REQUIRE_MULTI_TRIGGER=true


# ---------- Level 1 thresholds (technical hard rules) ----------
# Skip the trade when RSI >= L1_RSI_OVERBOUGHT or RSI <= L1_RSI_OVERSOLD
L1_RSI_OVERBOUGHT=70
L1_RSI_OVERSOLD=30
# Volatility band on ATR/price (%) - outside the band -> skip.
#
# ⚠ TESTING ONLY (Day 5): the band below is intentionally widened
# (0.05 .. 12.0) so the Hyperliquid / PositionManager / Router pipeline
# can be exercised against live markets without L1 short-circuiting
# every cycle on currently-quiet symbols. The production-safe values
# are L1_ATR_PCT_MIN=0.15 / L1_ATR_PCT_MAX=6.0 - tighten back before
# any mainnet rollout. See AGENTS.md §2.2.
L1_ATR_PCT_MIN=0.05
L1_ATR_PCT_MAX=12.0
# EMA pair used for the trend filter
L1_EMA_FAST=9
L1_EMA_SLOW=21
L1_RSI_PERIOD=14
L1_ATR_PERIOD=14
# Comma-separated timeframes (must all agree on trend)
L1_TIMEFRAMES=15m,1h
L1_KLINES_LIMIT=150
# When true, the trend filter requires every configured timeframe to
# agree on the trend direction; otherwise L1 blocks with `trend_mixed`.
#
# ⚠ TESTING ONLY (Day 5): default below is `false` so a 15m / 1h split
# doesn't veto every cycle while we test the rest of the pipeline.
# Production-safe value is `true` - re-enable before mainnet so the
# trend filter is back to its strict form.
L1_REQUIRE_TF_AGREEMENT=false


# ---------- L3 override of L1 block (NEW in Day 5) ----------
# When true (default), a Level 1 BLOCK no longer short-circuits the
# entire cascade. Instead the engine runs Level 2 + Level 3 and hands
# Claude the full L1 block reasons + per-symbol indicator table so
# the arbiter can critically audit whether the block is actually
# justified. Hard blocks (drawdown_breach, ohlcv_unavailable) are
# NEVER overrideable - drawdown is sacred and missing data means we
# can't trade safely. See AGENTS.md §2.4 + prompts/level3_arbiter_critical.md.
ALLOW_L3_TO_OVERRIDE_L1=true
# Minimum L3 conviction (0..1) required to actually override L1.
# Anything below this is treated as a decline-to-override and the
# engine still short-circuits. Default 0.55 ≈ "moderately confident
# disagreement"; raise to 0.7 for stricter override gating.
L3_OVERRIDE_MIN_CONVICTION=0.55

# Master knob for L3's aggression vs caution trade-off (Day 6+).
# This SAME knob is honoured by both layers:
#   * the main L3 arbiter (cycle-level, decides whether to open
#     a fresh perp position), and
#   * the per-position Smart Path in the PositionManager (decides
#     whether to override the Fast Path on an open position).
#
# Values: conservative | balanced | aggressive
#
#   conservative - legacy skeptical-by-default behaviour.
#                  Main arbiter:  conviction x0.90, intensity x0.90,
#                                 no HOLD-rescue at the engine level.
#                  Smart Path:    override threshold raised to 0.75
#                                 confidence; partial closes shrink
#                                 by 0.85x. Use when drawdown is
#                                 elevated or you want max safety.
#   balanced     - DEFAULT.
#                  Main arbiter:  no multipliers; verdict goes
#                                 through as-is.
#                  Smart Path:    override threshold 0.55; partial
#                                 closes 1.0x. HOLD-rescue OFF by
#                                 default (set ENABLE_HOLD_RESCUE=true
#                                 above to force it on under
#                                 balanced).
#   aggressive   - Lean-in mode.
#                  Main arbiter:  conviction x1.10, intensity x1.15.
#                                 HOLD-rescue rule active (see
#                                 L3_HOLD_RESCUE_* below).
#                  Smart Path:    override threshold 0.45; partial
#                                 closes scale 1.15x. HOLD-rescue
#                                 ON; a HOLD reply to a rescue
#                                 trigger is auto-rewritten to a
#                                 small defensive partial close.
L3_AGGRESSION=balanced
# Minimum L2 conviction required for the HOLD-rescue rule to fire
# (only applied under L3_AGGRESSION=aggressive).
L3_HOLD_RESCUE_L2_MIN=0.65
# Intensity used when HOLD-rescue fires. Small by design - we're
# overriding the LLM's judgement, so size conservatively.
L3_HOLD_RESCUE_INTENSITY=0.30


# ---------- Anti-chop router guards (Day-6+ / Stage 4) ----------
# Hyperliquid nets same-side opens into the existing position, so a
# re-affirmed `risk_on` on a side we already hold silently stacks
# notional. When true (default), the AllocationRouter refuses such a
# duplicate open and lets the PositionManager keep stewardship. Flip
# to false only for an averaging-down strategy under a different
# risk model.
BLOCK_DUPLICATE_SAME_SIDE_OPENS=true
# Post-stop-out cooldown: after a stop_loss close, refuse a NEW entry
# on the SAME symbol for POST_STOP_COOLDOWN_MINUTES. Breaks the
# "stop -> instant re-entry -> stop again" chop loop. Per-symbol (a
# long stop-out also blocks an immediate short re-entry). The
# cooldown is owned by the PositionManager and queried by the router,
# so there is one source of truth. An in-progress side_flip is exempt
# so its close+reopen chain can complete. Set ENABLE_POST_STOP_COOLDOWN
# =false or POST_STOP_COOLDOWN_MINUTES=0 to disable (e.g. a
# mean-reversion strategy that wants to re-enter quickly).
ENABLE_POST_STOP_COOLDOWN=true
POST_STOP_COOLDOWN_MINUTES=30.0


# ---------- Day-2 Risk Engine (portfolio-level controls) ----------
# Layered over the per-trade sizing pipeline by
# src/allocation/risk_engine.py. Every default below is a NO-OP on a
# flat account; tighten them as the account scales.
#
# (Stage 6a) Minimum equity to trade: below this, the router holds
# cash / USYC instead of churning a sub-scale account through fees.
# 0 disables. e.g. 200 parks a sub-$200 account.
MIN_EQUITY_TO_TRADE_USD=0.0
# Post-loss warm-up: after a stop-out / daily-DD flatten / any close
# whose loss clears WARMUP_TRIGGER_LOSS_PCT of equity, EVERY new entry
# is sized x WARMUP_SIZE_MULT and ramps back to 1.0 over
# WARMUP_AFTER_LOSS_MINUTES. Complements the per-symbol post-stop
# cooldown by de-risking the WHOLE book briefly after a loss.
ENABLE_LOSS_WARMUP=true
WARMUP_AFTER_LOSS_MINUTES=60.0
WARMUP_SIZE_MULT=0.5
WARMUP_TRIGGER_LOSS_PCT=1.0
# Correlated-exposure cap: max aggregate SAME-SIDE notional across a
# correlation group (BTC+ETH) as a % of equity. Shrinks or refuses a
# new open that would breach it - stops the same directional bet being
# taken twice under two tickers.
ENABLE_CORRELATION_CAP=true
MAX_CORRELATED_EXPOSURE_PCT=150.0
# (Stage 6b) Pre-trade EV filter: TP reward must beat the round-trip
# cost (fees + slippage) by EV_MIN_REWARD_TO_COST. Pairs with the
# per-asset ATR cap (too-hot) to reject too-cold (sub-economic) entries.
ENABLE_PRETRADE_EV_FILTER=true
ROUND_TRIP_COST_BPS=12.0
EV_MIN_REWARD_TO_COST=2.0
# Per-asset notional caps (USD) on top of global MAX_POSITION_USD.
# 0 = use the global cap for that asset.
MAX_POSITION_USD_BTC=0.0
MAX_POSITION_USD_ETH=0.0
MAX_POSITION_USD_DEFAULT=0.0


# ---------- Market data (Level 1 OHLCV via Dune MCP) ----------
# Level 1 reads OHLCV through the Dune `ohlcv` saved query (see
# dune/queries/ohlcv.sql). OHLCV_LOOKBACK_HOURS controls the window
# fetched per cycle - 48h is enough for the EMA21 + ATR14 stack.
OHLCV_LOOKBACK_HOURS=48
