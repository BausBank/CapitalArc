# ============================================================
# CapitalArc - Environment configuration TEMPLATE
# ------------------------------------------------------------
# This file is committed to git and contains placeholders only.
# DO NOT put real secrets here.
#
# To set up your local environment:
#   1. Copy this file:  cp .env.example .env
#   2. Replace every "your_..._here" placeholder with a real value.
#   3. Never commit `.env` - it is git-ignored on purpose.
# ============================================================


# ---------- General ----------
# Runtime mode: dev | staging | prod
APP_ENV=dev
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Decision loop interval in seconds
DECISION_INTERVAL_SECONDS=60
# Demo mode: Level 2 caches results for DEMO_CACHE_TTL_SECONDS
DEMO_MODE=true
DEMO_CACHE_TTL_SECONDS=1800


# ---------- Arc Chain ----------
# RPC endpoint for Arc (testnet or mainnet)
ARC_RPC_URL=https://rpc.testnet.arc.network
# Arc chain ID (numeric)
ARC_CHAIN_ID=your_arc_chain_id_here
# Arc block explorer base URL (used for tx links in logs)
ARC_EXPLORER_URL=your_arc_explorer_url_here


# ---------- Arc Perp DEX ----------
# Address of the Arc Perp DEX entry contract (ClearingHouse).
#
# Strong candidate from Arc Testnet Blockscout (verified, active stack
# with ClearingHouse + USDCCollateralVault + MarketRegistry + PositionLedger):
#   ClearingHouse        0x70a069462195E57A4f2E9aCb626Cf1d7E6aF9892
#   USDCCollateralVault  0x75E4FBFBA942A82F0f5CA9663571233823A71f11
#   MarketRegistry       0x9cED23e4a154769a5578D14BA63c01775003feB1
#   PositionLedger       0xd6D772918435a11d03E71158aFd44f3d48a1E148
# (All four deployed by 0x880bd26Adc300d37af797F999C20c69243F61ec8.)
#
# WARNING: there is a *second* verified contract on Arc Testnet also named
# "PositionLedger" at 0x4ac9c8A1F68c6d8979343746825Df09DD1907b44 - it belongs
# to an unrelated Polymarket-arb agent (signature: openPosition(conditionId,
# tokenId, side, usdcSpent, sharesReceived, ..., kellyFractionBps, ...,
# reasoningCid, polygonTxHash, cctpNonce)). It is NOT part of this perp DEX
# stack. The correct PositionLedger for our perp DEX is the one above,
# keyed by (accountId, marketId).
#
# NOTE: this stack uses an off-chain orderbook + on-chain batch settlement
# (ClearingHouse.settleBatch). Users sign EIP-712 OrderTypes.Order off-chain
# and deposit margin directly to USDCCollateralVault.deposit(accountId,amount).
# It does NOT expose a `openPosition`/`closePosition` router style.
#
# TODO: confirm with #agora-hackers / Arc team whether this is the official
# venue for RFB 04. Until confirmed, leave the value as a placeholder.
ARC_PERP_ROUTER_ADDRESS=your_arc_perp_router_address_here   # TODO: find in #agora-hackers or Blockscout
# Companion contracts of the candidate perp DEX stack (optional, can be left blank).
ARC_PERP_VAULT_ADDRESS=your_arc_perp_vault_address_here
ARC_PERP_MARKET_REGISTRY_ADDRESS=your_arc_perp_market_registry_address_here
ARC_PERP_POSITION_LEDGER_ADDRESS=your_arc_perp_position_ledger_address_here
# Default leverage cap for risk-on positions (e.g. 3 = 3x)
ARC_PERP_MAX_LEVERAGE=3
# Default trading symbols (comma separated)
ARC_PERP_SYMBOLS=BTC-PERP,ETH-PERP


# ---------- Circle: Developer-Controlled Wallets ----------
# Circle API key (Developer-Controlled Wallets). Use a TEST key for the sandbox.
CIRCLE_API_KEY=your_circle_api_key_here
# Entity secret used to encrypt wallet operations (generate from Circle console)
CIRCLE_ENTITY_SECRET=your_circle_entity_secret_here
# Wallet set ID where the agent's wallets live
CIRCLE_WALLET_SET_ID=your_circle_wallet_set_id_here
# Specific wallet ID used as the agent's primary execution wallet
CIRCLE_AGENT_WALLET_ID=your_circle_agent_wallet_id_here


# ---------- Circle: CCTP (Cross-Chain Transfer Protocol) ----------
# Source chain domain ID (for CCTP transfers into Arc)
CCTP_SOURCE_DOMAIN=your_cctp_source_domain_here
# Destination chain domain ID (Arc)
CCTP_DESTINATION_DOMAIN=your_cctp_destination_domain_here
# CCTP TokenMessenger contract address on the source chain
CCTP_TOKEN_MESSENGER_ADDRESS=your_cctp_token_messenger_address_here
# CCTP MessageTransmitter contract address
CCTP_MESSAGE_TRANSMITTER_ADDRESS=your_cctp_message_transmitter_address_here


# ---------- Circle: Paymaster (gasless tx) ----------
# Paymaster URL / endpoint used to sponsor gas
CIRCLE_PAYMASTER_URL=your_circle_paymaster_url_here
# Paymaster policy ID, if applicable
CIRCLE_PAYMASTER_POLICY_ID=your_circle_paymaster_policy_id_here


# ---------- USYC (Yield-bearing USDC, risk-off leg) ----------
# USYC token contract address on Arc
USYC_TOKEN_ADDRESS=your_usyc_token_address_here
# USYC mint/redeem contract address
USYC_MINT_CONTRACT_ADDRESS=your_usyc_mint_contract_address_here
# Minimum balance threshold (in USDC) to trigger rotation into USYC
USYC_MIN_ROTATION_AMOUNT=100


# ---------- USDC ----------
# Native / canonical USDC address on Arc
USDC_TOKEN_ADDRESS=your_usdc_token_address_here


# ---------- Dune MCP (single source of truth for L1 + L2) ----------
# Dune MCP is the *only* market-data source for the agent. Both Level 1
# (OHLCV / TA) and Level 2 (on-chain intelligence) read through saved
# Dune queries. No CEX feed, no direct RPC market-data scraping.
#
# Arc Testnet isn't indexed by Dune yet, so the saved queries target
# a live, high-liquidity EVM chain (`ethereum` by default; `base` /
# `arbitrum` are trivially selectable). The agent's symbols
# (BTC-PERP / ETH-PERP) map to the canonical on-chain wraps of
# BTC / ETH on the chosen chain.
#
# Dune Analytics API key (used by the MCP client for on-chain queries)
DUNE_API_KEY=your_dune_api_key_here
# Dune MCP server URL (LLM-facing tool surface)
DUNE_MCP_URL=https://mcp.dune.com/sse
# Dune REST endpoint that the MCP server wraps (we hit this directly
# with the same DUNE_API_KEY for deterministic, cacheable reads).
DUNE_API_BASE_URL=https://api.dune.com/api/v1
# Max age (seconds) for a cached Dune result before re-querying
DUNE_CACHE_TTL_SECONDS=1800
# Active chain for L1 + L2 (matches `dex.trades.blockchain` and the
# `erc20_<chain>.evt_Transfer` schema). Supported out of the box:
# ethereum, base, arbitrum.
DUNE_CHAIN=ethereum
# Default lookback window (hours) for time-series metrics.
DUNE_LOOKBACK_HOURS=24

# Dune REST throttling: L2 fans out 8 metric calls + L1 fans out 1
# OHLCV call in parallel. On free-tier plans the burst hits HTTP 429
# and metrics render as `error`. The client caps concurrent in-flight
# requests with a semaphore and retries 429s with exponential
# backoff. Defaults are tuned for free tier (~10 reqs/min). Bump
# CONCURRENT_REQUESTS to 6-8 if you have a paid Dune plan.
DUNE_MAX_CONCURRENT_REQUESTS=2
DUNE_RATE_LIMIT_MAX_RETRIES=6
DUNE_RATE_LIMIT_BACKOFF_SECONDS=2.5

# Optional per-token overrides. Blank = use the built-in canonical
# map (WBTC/cbBTC, WETH, native USDC on each chain).
DUNE_TOKEN_BTC_ADDRESS=
DUNE_TOKEN_ETH_ADDRESS=
DUNE_TOKEN_USDC_ADDRESS=

# Address watched by vault_flows.sql for USDC deposits / withdrawals.
# Defaults to ARC_PERP_VAULT_ADDRESS when unset; point at any vault
# on DUNE_CHAIN (e.g. Synthetix V3 collateral on Base) for real data.
DUNE_PERP_VAULT_ADDRESS=

# Whale threshold (USD) for whale_activity.sql.
DUNE_WHALE_MIN_USD=250000

# Per-metric saved Dune query ids. Save the SQL files in dune/queries/
# to your Dune workspace, then paste the resulting numeric ids here.
# `DUNE_QUERY_OHLCV_ID` is required for Level 1 to evaluate; without
# it Level 1 honestly blocks on `ohlcv_unavailable`.
DUNE_QUERY_OHLCV_ID=
DUNE_QUERY_FUNDING_RATES_ID=
DUNE_QUERY_OPEN_INTEREST_ID=
DUNE_QUERY_VOLUME_ID=
DUNE_QUERY_VAULT_FLOWS_ID=
DUNE_QUERY_WHALE_ACTIVITY_ID=
DUNE_QUERY_LONG_SHORT_RATIO_ID=
DUNE_QUERY_CUM_FUNDING_ID=
DUNE_QUERY_MARKET_SENTIMENT_ID=


# ---------- Level 3 Intelligence: Claude Sonnet 4.6 via OpenRouter ----------
# OpenRouter API key: setting this is the ONLY toggle needed to switch
# L3 from synthetic placeholder to real Claude arbitration. Leave it
# blank and the engine emits a synthetic L3 whose weight is
# redistributed back to L1+L2 (REDISTRIBUTE_SYNTHETIC_L3_WEIGHT below).
#
# We migrated from Google's Gemini API (geo-locked away from several
# user regions, returns `400 User location is not supported` even on
# paid tier) to OpenRouter, which routes through their own
# infrastructure and stays globally accessible. The default upstream
# model is Anthropic's Claude Sonnet 4.6; switch to any model slug on
# https://openrouter.ai/models with a one-line change here.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Upstream model slug. Examples:
#   anthropic/claude-sonnet-4.6       (default, balanced reasoning)
#   anthropic/claude-opus-4.5         (deeper reasoning, ~3x cost)
#   openai/gpt-4o                     (fast, JSON-mode native)
#   mistralai/mistral-large-2411      (cheaper alternative)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Sampling temperature (0.0 = deterministic, recommended for trading)
OPENROUTER_TEMPERATURE=0.2
# Max output tokens per arbitration call. 2048 gives the critical-mode
# 5-section rationale room (Market Context / Key Signals Analysis /
# Contradictions & Risks / My Independent View / Final Recommendation
# typically lands at 600-1100 tokens; 1024 risks truncation on rich
# signal tables). Standard mode is unaffected - it rarely exceeds ~300.
OPENROUTER_MAX_TOKENS=2048
# Request timeout in seconds. Claude often takes 5-15s end-to-end.
OPENROUTER_TIMEOUT_SECONDS=60
# Bounded retry on transient failures (429 rate-limit, 5xx upstream,
# malformed JSON). Hard failures (auth, model-not-found, policy denial)
# bypass the retry loop and surface immediately with an actionable
# diagnosis. After exhausting all attempts the arbiter falls back to
# a neutral HOLD - we never trade on a hallucinated verdict.
OPENROUTER_MAX_RETRIES=2
OPENROUTER_BACKOFF_SECONDS=2.0
# Optional analytics headers - visible on https://openrouter.ai/activity
# (useful when one key is shared across multiple projects).
OPENROUTER_REFERER=https://github.com/capitalarc/capitalarc
OPENROUTER_APP_TITLE=CapitalArc

# ---------- Level 3 mode ----------
# CapitalArc ships two distinct Level 3 personas:
#   - "critical" (default, recommended): Claude acts as an independent
#     senior risk manager. It is *allowed to disagree* with L1+L2 when
#     signals are weak or contradictory, and the rationale follows a
#     strict 5-section template so the demo shows *how* the decision
#     was reached. Best for product / hackathon demos.
#       Sections: Market Context | Key Signals Analysis |
#                 Contradictions & Risks | My Independent View |
#                 Final Recommendation
#   - "standard": legacy trader-voice prompt. Short 1-2 sentence
#     rationale with technical tags. Useful for high-frequency loops
#     where the structured rationale is overkill.
# Both modes share the same OpenRouter client + JSON schema -
# switching is a single line, no other env changes needed. Each mode
# resolves a distinct prompt file under `prompts/` (see
# prompts/level3_arbiter_critical.md / level3_arbiter_standard.md).
L3_MODE=critical


# ---------- Risk & Allocation ----------
# Final-score threshold above which the router goes risk-on (0.0 - 1.0)
RISK_ON_THRESHOLD=0.6
# Final-score threshold below which the router goes risk-off into USYC (0.0 - 1.0)
RISK_OFF_THRESHOLD=0.4
# Maximum portfolio drawdown before forced de-risk (percent)
MAX_DRAWDOWN_PCT=10

# Decision-engine level weights (must sum to 1.0)
WEIGHT_LEVEL1=0.25
WEIGHT_LEVEL2=0.35
WEIGHT_LEVEL3=0.40


# ---------- Conviction / direction controls ----------
# Minimum aggregated *direction strength* in [0, 1] for the engine to
# treat the side as decided. Direction is a conviction-weighted vote
# across L1 (primary symbol trend), L2 (on-chain bias) and L3 (when
# wired). Lower => more aggressive opens in either direction; higher
# => only the cleanest setups trade. The L1 short-circuit guard
# always wins, so a blocked L1 never opens.
SHORT_BIAS_MIN_STRENGTH=0.35
# Minimum direction strength required to override a mid-band hold and
# open a *reduced-size* position when the aggregated conviction is
# ambiguous but the directional signal is unanimous. Reduced
# intensity formula: `0.5 * conviction * direction_strength`.
STRONG_BIAS_OPEN_STRENGTH=0.6
# When true (default), a synthetic L3 score (no real Gemini wiring
# yet) gets its weight redistributed proportionally to L1 + L2 during
# aggregation, so the placeholder doesn't silently dilute the real
# signal back into itself. Flip to false to restore the legacy
# behaviour where synthetic L3 votes with its configured weight.
REDISTRIBUTE_SYNTHETIC_L3_WEIGHT=true

# ---------- Short-selling controls ----------
# When true, shorts use the same sizing pipeline as longs
# (recommended). Set to false + tune SHORT_SIZE_MULTIPLIER if you
# want half-size shorts during ramp-up.
SYMMETRIC_SHORT_SIZING=true
SHORT_SIZE_MULTIPLIER=1.0

# ---------- Position sizing (vol-targeted + DD haircut) ----------
# Sizing pipeline:
#   1) Vol-target: size = (equity * TARGET_RISK_PCT) /
#                          (STOP_ATR_MULT * ATR_pct/100)
#      So 2% risk / 1.5*ATR / ATR%=2% on $1k equity -> $667 notional.
#   2) Multiply by intensity (engine conviction signal in [0, 1]).
#   3) Drawdown haircut: multiply by
#      max(0, 1 - (dd_pct/max_dd_pct) ** DD_HAIRCUT_EXPONENT).
#   4) Cap at MAX_POSITION_USD.
# Fallback when equity is 0 (first dry-run cycle, no margin yet):
# BASE_POSITION_USD * (1 + intensity).
BASE_POSITION_USD=1000
MAX_POSITION_USD=10000
TARGET_RISK_PCT=0.02
STOP_ATR_MULT=1.5
# ATR% floor used in the sizing denominator (avoids divide-by-zero
# and absurdly large sizes when ATR collapses). Keep close to
# L1_ATR_PCT_MIN below.
MIN_ATR_PCT_FOR_SIZING=0.25
# Exponent of the gradient drawdown haircut. 1.0 = linear (5% dd -> 50%
# size); 2.0 = soft early, hard near the cap (5% dd -> 75% size,
# 9% dd -> 19% size). Replaces the legacy "all-or-nothing at
# MAX_DRAWDOWN_PCT" behaviour.
DD_HAIRCUT_EXPONENT=2.0
# When true, the router stamps a full sizing breakdown
# (vol_target, intensity, haircut, atr_pct, etc.) onto each
# ExecutionPlan so the panel can render the "why" behind each size.
EXPLAIN_SIZING=true


# ---------- Level 1 thresholds (technical hard rules) ----------
# Skip the trade when RSI >= L1_RSI_OVERBOUGHT or RSI <= L1_RSI_OVERSOLD
L1_RSI_OVERBOUGHT=70
L1_RSI_OVERSOLD=30
# Volatility band on ATR/price (%) - outside the band -> skip
L1_ATR_PCT_MIN=0.15
L1_ATR_PCT_MAX=6.0
# EMA pair used for the trend filter
L1_EMA_FAST=9
L1_EMA_SLOW=21
L1_RSI_PERIOD=14
L1_ATR_PERIOD=14
# Comma-separated timeframes (must all agree on trend)
L1_TIMEFRAMES=15m,1h
L1_KLINES_LIMIT=150
# When true, the trend filter requires all timeframes to align
L1_REQUIRE_TF_AGREEMENT=true


# ---------- Market data (Level 1 OHLCV via Dune MCP) ----------
# Level 1 reads OHLCV through the Dune `ohlcv` saved query (see
# dune/queries/ohlcv.sql). OHLCV_LOOKBACK_HOURS controls the window
# fetched per cycle - 48h is enough for the EMA21 + ATR14 stack.
OHLCV_LOOKBACK_HOURS=48
