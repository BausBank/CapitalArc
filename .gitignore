# ============================================================
# CapitalArc - .gitignore
# ============================================================

# --- Secrets / env ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Testing & coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.cache/

# --- Logs & runtime data ---
logs/
*.log
/data/
runs/
artifacts/
checkpoints/
recovery/
*.sqlite
*.db

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.cursor/
.vscode/
.idea/
*.swp
*.swo
*~

# --- Node (in case of frontend later) ---
node_modules/
.next/
.turbo/
.pnpm-store/

# --- Build / temp ---
tmp/
temp/
*.tmp
*.bak

# --- Internal / non-public project assets ---
# Internal design docs (the public README embeds the diagrams already)
/diagrams/
# Sensitive prompt templates (kept locally, not for public mirror)
/prompts/
# Internal context, handoffs and working notes
/docs/
CONTEXT.md
README-RFB1.md
demo_clean_output.txt
demo_*.txt
*.demo.txt

# --- Final hackathon-submission cleanup ---
prompts/
AGENTS.md
diagrams/
CONTEXT.md
pytest.ini
tests/

# --- Internal modules (kept locally, hidden from public mirror) ---
# Legacy / internal executors not part of the production trading path.
src/execution/arc_perp_executor.py
src/execution/usyc_executor.py
# Internal logging plumbing - swapped for `logging.getLogger` at the
# call sites in the public modules.
src/utils/logging.py
# Placeholder package not used on the public surface.
src/agents/
