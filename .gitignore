# ============================================================
# CapitalArc - .gitignore
# ============================================================

# --- Secrets / env ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Testing & coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.cache/

# --- Logs & runtime data ---
logs/
*.log
/data/
runs/
artifacts/
checkpoints/
*.sqlite
*.db

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Node (in case of frontend later) ---
node_modules/
.next/
.turbo/
.pnpm-store/

# --- Build / temp ---
tmp/
temp/
*.tmp
*.bak

# --- External / vendored docs cloned at root level ---
/docs/
